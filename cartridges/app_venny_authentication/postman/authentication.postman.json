{
  "info": {
    "name": "Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Authentication endpoints for Venny I/O. These requests require Authorization: Bearer {{api_key}} and scope user/session behavior to the authenticated app."
  },
  "item": [
    {
      "name": "/sign-up",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{api_key}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_email\": \"ada@example.com\",\n  \"password\": \"{{user_password}}\",\n  \"password_confirmation\": \"{{user_password}}\",\n  \"user_username\": \"ada\",\n  \"user_displayname\": \"Ada Lovelace\",\n  \"user_attributes\": {\n    \"source\": \"postman\",\n    \"cartridge\": \"app_venny_authentication\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/sign-up", "host": ["{{base_url}}"], "path": ["sign-up"] }
      },
      "response": []
    },
    {
      "name": "/sign-in",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{api_key}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_email\": \"ada@example.com\",\n  \"password\": \"{{user_password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/sign-in", "host": ["{{base_url}}"], "path": ["sign-in"] }
      },
      "response": []
    },
    {
      "name": "/sign-out",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{api_key}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"user_id\": \"{{user_id}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/sign-out", "host": ["{{base_url}}"], "path": ["sign-out"] }
      },
      "response": []
    },
    {
      "name": "/request-password",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{api_key}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_email\": \"ada@example.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/request-password", "host": ["{{base_url}}"], "path": ["request-password"] }
      },
      "response": []
    },
    {
      "name": "/reset-password",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{api_key}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reset_token\": \"{{reset_token}}\",\n  \"password\": \"{{new_password}}\",\n  \"password_confirmation\": \"{{new_password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/reset-password", "host": ["{{base_url}}"], "path": ["reset-password"] }
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "base_url", "value": "https://api.withvenny.app" },
    { "key": "api_key", "value": "" },
    { "key": "user_id", "value": "user_replace_me" },
    { "key": "session_id", "value": "session_replace_me" }
  ]
}
